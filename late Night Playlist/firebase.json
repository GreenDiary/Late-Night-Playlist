{
  "hosting": [
    {
      "target": "live",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**",
        "README.md",
        "firebase.database.rules.json"
      ]
    },
    {
      "target": "old",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**",
        "README.md",
        "firebase.database.rules.json"
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "https://latenightplaylist.web.app/",
          "type": 301
        },
        {
          "source": "/**",
          "destination": "https://latenightplaylist.web.app/",
          "type": 301
        }
      ]
    }
  ]
}
